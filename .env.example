# ─────────────────────────────────────────────────────────────
# Maya Lane Shop: environment variables
# Copy to .env and fill in. Only the "Required" block is needed to run locally;
# every integration below degrades gracefully when unset.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for emails, Stripe redirects, sitemap, OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Postgres. Neon/Supabase: use the POOLED connection string here.
# Zero-install local option: run `npm run db:local` and use the URL below.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1"
# Optional: DIRECT (non-pooled) URL for migrations on Neon/Supabase.
DIRECT_URL=""

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed when running behind a proxy or on non-Vercel hosts.
AUTH_TRUST_HOST="true"

# Signs expiring download links for digital products (falls back to AUTH_SECRET).
DOWNLOAD_TOKEN_SECRET=""

# The email that becomes ADMIN (seeded, and auto-promoted on first sign-in).
ADMIN_EMAIL="admin@mayalane.shop"

# ── Demo mode ────────────────────────────────────────────────
# Shows the demo banner + one-click "Demo customer" / read-only "Demo admin" logins.
# Set to "false" for a real store.
NEXT_PUBLIC_DEMO_MODE="true"

# ── Stripe (test mode) ───────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the webhook endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Set to "true" once Stripe Tax is configured to calculate tax at checkout.
STRIPE_AUTOMATIC_TAX="false"

# ── Google sign-in (optional) ────────────────────────────────
# OAuth client (Web). Authorized redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Resend (transactional email + magic links) ───────────────
# Without a key, emails and magic links are printed to the server console.
RESEND_API_KEY=""
# Must be on a domain verified in Resend (onboarding@resend.dev works for testing to your own address).
EMAIL_FROM="Maya Lane Shop <orders@yourdomain.com>"
# Where brand inquiry notifications go (defaults to ADMIN_EMAIL).
INQUIRY_NOTIFY_EMAIL=""

# ── Cloudinary (product images + private digital files) ──────
# Without these, admins can paste image URLs and digital uploads go to local disk (dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="maya-lane-shop"
